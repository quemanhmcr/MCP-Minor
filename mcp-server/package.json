{
  "name": "dirac-codebase-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP server for selected Dirac codebase tools.",
  "bin": {
    "dirac-codebase-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-tree-sitter-assets.mjs",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "measure:output-size": "tsx scripts/measure-output-size.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.11"
  }
}
